-- ============================================================
-- PIN hash pentru toate conturile de test
-- Formula: SHA256(pan || '1234') cu salt implicit = pan
--
-- PoC simplification: SHA256 simplu e vulnerabil la brute-force
-- pe PIN-uri de 4 cifre (10.000 combinații). Acceptabil pentru demo.
-- Producție OBLIGATORIU: PBKDF2-HMAC-SHA256 cu 100.000 iterații
-- și salt random per cont stocat separat în coloană dedicată.
--
-- PIN de test pentru TOATE conturile: 1234
-- CVV-urile sunt în docs/DEMO_SCENARIOS.md — PIN-ul NU apare niciodată
-- în fișiere SQL sau cod sursă (aceeași regulă ca CVV).
-- ============================================================
UPDATE accounts
SET pin_hash = encode(sha256((pan || '1234')::bytea), 'hex')
WHERE pin_hash IS NULL;