# ============================================================
# .env.example — TEMPLATE pentru variabilele de mediu
#
# INSTRUCȚIUNI PENTRU COLEGII DIN ECHIPĂ:
# 1. Copiați acest fișier: cp .env.example .env
# 2. Completați valorile reale în .env
# 3. NICIODATĂ nu urcați .env pe GitHub!
#
# De ce separăm secretele de cod?
# - Codul poate fi public (GitHub), secretele nu
# - Fiecare mediu (dev, producție) are chei diferite
# - Dacă cheia e în cod și faci un commit greșit, e expusă
# ============================================================


# --- GENERAL ------------------------------------------------
# Mediul în care rulează aplicația
# Valori posibile: development | production
ENVIRONMENT=development


# --- PAYMENT GATEWAY ----------------------------------------
# Portul pe care ascultă Gateway-ul
GATEWAY_PORT=8001

# Câte cereri pe secundă permite un singur terminal POS
# (din spec: maxim 2 req/sec per terminal)
GATEWAY_RATE_LIMIT_PER_TERMINAL=2

# Câte cereri pe secundă per adresă IP
GATEWAY_RATE_LIMIT_PER_IP=10

# Pragul global de TPS înainte de Circuit Breaker
# (din spec: 150 TPS = 3x baseline de 50 TPS)
GATEWAY_CIRCUIT_BREAKER_TPS=150


# --- TOKEN SERVICE PROVIDER (TSP) ---------------------------
TSP_PORT=8002


# --- CARD NETWORK ROUTER ------------------------------------
CARD_NETWORK_PORT=8003


# --- ISSUING BANK -------------------------------------------
ISSUING_BANK_PORT=8004

# Cheia master folosită pentru HMAC-SHA256
# În producție: minim 32 bytes aleatorii, generate cu:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Aceasta e o cheie FALSĂ doar pentru exemplu!
ISSUING_BANK_HMAC_MASTER_KEY=INLOCUIESTE_CU_O_CHEIE_REALA_DE_64_CARACTERE_HEX


# --- DASHBOARD ----------------------------------------------
DASHBOARD_PORT=8005


# --- REDIS --------------------------------------------------
# Adresa serverului Redis Master
REDIS_HOST=redis-master
REDIS_PORT=6379

# Parola Redis (setați una puternică!)
REDIS_PASSWORD=INLOCUIESTE_CU_O_PAROLA_PUTERNICA

# TTL (Time-To-Live) pentru cheile de idempotență
# Din spec: 24 ore = 86400 secunde
REDIS_IDEMPOTENCY_TTL_SECONDS=86400


# --- FRAUD ENGINE -------------------------------------------
# Pragurile de decizie din spec (Cap. 6.2)
FRAUD_SCORE_ALLOW_THRESHOLD=40
FRAUD_SCORE_STEP_UP_THRESHOLD=75

# Lambda pentru decay exponențial (din spec: 0.173)
# Produce un Half-Life de exact 4 ore
FRAUD_DECAY_LAMBDA=0.173

# Pragul de biometrie din aplicația mobilă (RON)
BIOMETRIC_THRESHOLD_RON=100
