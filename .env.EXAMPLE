# ============================================================
# .env.example — TEMPLATE pentru variabilele de mediu
#
# INSTRUCȚIUNI PENTRU COLEGII DIN ECHIPĂ:
# 1. Copiați acest fișier: cp .env.example .env
# 2. Completați valorile reale în .env
# 3. NICIODATĂ nu urcați .env pe GitHub!
# ============================================================


# --- GENERAL ------------------------------------------------
ENVIRONMENT=development


# --- PAYMENT GATEWAY ----------------------------------------
GATEWAY_PORT=8001
GATEWAY_RATE_LIMIT_PER_TERMINAL=2
GATEWAY_RATE_LIMIT_PER_IP=10
GATEWAY_CIRCUIT_BREAKER_TPS=150


# --- JWT AUTHENTICATION (Android) ---------------------------
# Generare secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=INLOCUIESTE_CU_SECRET_HEX_64_CARACTERE
JWT_TTL_DAYS=90


# --- TOKEN SERVICE PROVIDER (TSP) ---------------------------
TSP_PORT=8002


# --- CARD NETWORK ROUTER ------------------------------------
CARD_NETWORK_PORT=8003


# --- ISSUING BANKS ------------------------------------------
# Generează chei separate: python3 -c "import secrets; print(secrets.token_hex(32))"
BANK_BT_HMAC_KEY=INLOCUIESTE_CU_CHEIE_BT_64_HEX
BANK_BCR_HMAC_KEY=INLOCUIESTE_CU_CHEIE_BCR_64_HEX_DIFERITA
BANK_ING_HMAC_KEY=INLOCUIESTE_CU_CHEIE_ING_64_HEX_DIFERITA


# --- BIN PREFIXES (6 cifre) ---------------------------------
BIN_BT=400000
BIN_BCR=500000
BIN_ING=511111


# --- POSTGRESQL ---------------------------------------------
POSTGRES_ROOT_PASSWORD=INLOCUIESTE_CU_PAROLA_POSTGRES_ROOT
POSTGRES_BT_PASSWORD=INLOCUIESTE_CU_PAROLA_BT
POSTGRES_BCR_PASSWORD=INLOCUIESTE_CU_PAROLA_BCR
POSTGRES_ING_PASSWORD=INLOCUIESTE_CU_PAROLA_ING


# --- DASHBOARD ----------------------------------------------
DASHBOARD_PORT=8005

# --- ESP32 TERMINAL -----------------------------------------
ESP32_HOST=localhost
ESP32_PORT=8088


# --- BANK API URL (teste locale în afara Docker) ------------
# În Docker, serviciile se văd după hostname. De pe laptop, folosești localhost.
BANK_BT_API_URL=http://localhost:8004


# --- REDIS --------------------------------------------------
REDIS_HOST=redis-master
REDIS_PORT=6379
REDIS_PASSWORD=INLOCUIESTE_CU_O_PAROLA_PUTERNICA
REDIS_IDEMPOTENCY_TTL_SECONDS=86400


# --- FRAUD ENGINE -------------------------------------------
FRAUD_SCORE_ALLOW_THRESHOLD=40
FRAUD_SCORE_STEP_UP_THRESHOLD=75
FRAUD_DECAY_LAMBDA=0.173
BIOMETRIC_THRESHOLD_RON=100
